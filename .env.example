# Copy this file to .env and fill in real values. Never commit .env.
# Frontend code reads variables with import.meta.env.VARIABLE_NAME (only names starting with VITE_).
# Backend code reads them with os.getenv("VARIABLE_NAME").

# Back-End Variables
# Leave DATABASE_URL unset to use a local SQLite database.
DATABASE_URL=postgres://username:password@localhost:5432/bag_of_holding
# Secrets: generate each with  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_APP_KEY=replace-me
JWT_SECRET_KEY=replace-me
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Front-End Variables
VITE_BASENAME=/
# URL of the Flask API, with a trailing slash
VITE_BACKEND_URL=http://localhost:3001/
